# Local Debian/gosu build with dependency and Next.js cache mounts.
# Use with: docker build -f Dockerfile.local .
# syntax=docker/dockerfile:1.7
ARG NODE_IMAGE=node:22.23.4-bookworm-slim
ARG RUNNER_BASE=runner-base
FROM ${NODE_IMAGE} AS base
WORKDIR /app

FROM base AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
  python3 make g++ ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
  if [ -f package-lock.json ]; then npm ci --include=optional; else npm install --include=optional; fi \
  && npm install --no-save --build-from-source better-sqlite3

COPY . ./
ENV NEXT_TELEMETRY_DISABLED=1
ENV DATA_DIR=/tmp/9router-build-data
RUN --mount=type=cache,target=/app/.next/cache,sharing=locked \
  npm run build

FROM ${NODE_IMAGE} AS runner-base
WORKDIR /app

LABEL org.opencontainers.image.title="9router"

ENV NODE_ENV=production
ENV PORT=20128
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1
ENV DATA_DIR=/app/data

RUN apt-get update && apt-get install -y --no-install-recommends gosu ca-certificates ffmpeg \
  && rm -rf /var/lib/apt/lists/* \
  && printf '#!/bin/sh\nchown -R node:node /app/data /app/data-home 2>/dev/null\nexec gosu node "$@"\n' > /entrypoint.sh \
  && chmod +x /entrypoint.sh

FROM runner-base AS release-base
USER root
RUN sed -i 's|http://deb.debian.org|https://mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 update \
    && apt-get -o Acquire::Retries=3 -o Acquire::https::Timeout=30 install -y --no-install-recommends chromium fonts-noto-cjk xvfb xauth \
    && rm -rf /var/lib/apt/lists/*
COPY --link --from=codex-runtime / /opt/codex/
RUN test "$(/opt/codex/bin/codex --version)" = "codex-cli 0.169.1"
ENV CODEX_TRIAL_CLI=/opt/codex/bin/codex \
    CODEX_TRIAL_RUNTIME=/opt/codex \
    ACCOUNT_APPEAL_CHROMIUM=/usr/bin/chromium \
    ACCOUNT_APPEAL_XVFB=/usr/bin/xvfb-run

FROM ${RUNNER_BASE} AS runner
# COPY --link needs numeric ownership. Official Node images use node:node = 1000:1000.
ARG NODE_OWNER=1000:1000
COPY --chown=node:node --from=builder /app/public ./public
COPY --chown=node:node --from=builder /app/.next/static ./.next/static
COPY --chown=node:node --from=builder /app/.next/standalone ./
COPY --chown=node:node --from=builder /app/custom-server.js ./custom-server.js
COPY --chown=node:node --from=builder /app/open-sse ./open-sse
COPY --chown=node:node --from=builder /app/src/mitm ./src/mitm
COPY --link --chown=$NODE_OWNER --from=builder /app/node_modules/node-forge ./node_modules/node-forge
COPY --link --chown=$NODE_OWNER --from=builder /app/node_modules/undici ./node_modules/undici
COPY --link --chown=$NODE_OWNER --from=builder /app/node_modules/next ./node_modules/next
COPY --link --chown=$NODE_OWNER --from=builder /app/node_modules/sql.js ./node_modules/sql.js
COPY --link --chown=$NODE_OWNER --from=builder /app/node_modules/node-machine-id ./node_modules/node-machine-id
COPY --link --chown=$NODE_OWNER --from=builder /app/node_modules/playwright-core ./node_modules/playwright-core
COPY --link --chown=$NODE_OWNER --from=builder /app/node_modules/wreq-js ./node_modules/wreq-js
COPY --link --chown=$NODE_OWNER --from=builder /app/node_modules/@wreq-js ./node_modules/@wreq-js

RUN install -d -o node -g node /app/data /app/data-home && \
  ln -sf /app/data-home /root/.9router 2>/dev/null || true

EXPOSE 20128
ENTRYPOINT ["/entrypoint.sh"]
CMD ["node", "custom-server.js"]
